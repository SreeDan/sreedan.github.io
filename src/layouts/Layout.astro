---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = "Sreekara Dandibhotla" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Sreekara Dandibhotla — Backend and systems engineer, Georgia Tech CS student, Formula SAE Data Acquisition Lead." />
    <title>{title}</title>
  </head>
  <body class="bg-[#1a1a1a] text-white min-h-screen">
    <slot />
  </body>
</html>
