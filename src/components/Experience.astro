---
const experiences = [
  {
    company: "Plaid",
    role: "Software Engineer Intern",
    period: "May 2026 - Present",
    logo: "/logos/pt.avif",
  },
  {
    company: "Anduril Industries",
    role: "Software Engineer Intern",
    period: "May 2025 - August 2025",
    logo: "/logos/anduril.jpg",
  },
  {
    company: "Tesla",
    role: "Software Engineer Intern",
    period: "January 2025 - May 2025",
    logo: "/logos/tesla.png",
    logoSize: "32px",
  },
  {
    company: "HyTech Racing",
    role: "Lead Software Engineer",
    period: "January 2024 - Present",
    logo: "/logos/hytech.png",
  },
  {
    company: "Verint",
    role: "Software Engineer Intern",
    period: "May 2024 - August 2024",
    logo: "/logos/verint.png",
  },
];
---

<section id="experience" class="pt-10 pb-24 px-6 bg-[#212121]">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-4xl md:text-5xl font-bold text-center text-gray-200 mb-10">Experience</h2>

    <div class="relative">
      <!-- vertical line -->
      <div class="absolute top-0 bottom-0 bg-indigo-500/50" style="left: 10px; width: 2px;"></div>

      <div class="flex flex-col gap-5">
        {experiences.map((exp) => (
          <div class="flex items-start gap-5">
            <div
              class="relative z-10 rounded-full border-2 border-indigo-400 bg-[#212121] flex items-center justify-center shrink-0"
              style="width: 22px; height: 22px; margin-top: 20px;"
            >
              <div class="rounded-full bg-white" style="width: 8px; height: 8px;"></div>
            </div>

            <!-- card -->
            <div class="flex-1 rounded-lg border border-white/8 p-5" style="background: #272727;">
              <div class="flex items-center gap-3 mb-2">
                <img
                  src={exp.logo}
                  alt={exp.company}
                  style={`width: ${exp.logoSize ?? '48px'}; height: ${exp.logoSize ?? '48px'}; object-fit: contain;`}
                  class="rounded-md shrink-0"
                />
                <span class="font-bold text-white text-2xl">{exp.company}</span>
              </div>
              <p class="font-bold text-gray-200 text-base">{exp.role}</p>
              <p class="text-gray-400 text-sm mt-0.5">{exp.period}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
