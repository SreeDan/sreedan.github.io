<section id="contact" class="pt-10 pb-24 px-6 bg-[#1a1a1a]">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-200 mb-4">Contact</h2>
    <p class="text-gray-400 mb-10">Feel free to reach out for opportunities, collaborations, or just to say hi.</p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href="https://github.com/sreekara"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 border border-white/15 hover:border-white/40 rounded-lg px-5 py-2.5 text-gray-300 hover:text-white transition-colors font-medium"
